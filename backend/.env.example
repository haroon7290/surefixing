PORT=4000
MONGO_URI=mongodb://localhost:27017/surefix
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Python AI service. The backend falls back to its built-in scorer if it is down.
AI_SERVICE_URL=http://localhost:5001
AI_TIMEOUT_MS=2500

UPLOAD_DIR=uploads
# Comma-separated browser origins allowed to call the API; * allows all.
CORS_ORIGINS=*
# Requests per 15 minutes per IP (whole API / login+register+reset).
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=30

# Marketplace rules
PLATFORM_FEE_PERCENT=10
# Hours a client has to confirm a finished job before the technician can close it.
AUTO_CONFIRM_HOURS=72

# Wallet: deposits by transfer to a company account and withdrawals, both approved by an admin.
WALLET_MIN_DEPOSIT=100
WALLET_MAX_DEPOSIT=500000
WALLET_MIN_WITHDRAWAL=500
WALLET_MAX_PENDING_DEPOSITS=5

# Optional: real emails for password-reset codes, e.g.
#   SMTP_URL=smtps://you%40gmail.com:app-password@smtp.gmail.com
# Leave empty to print the codes in the backend console instead.
SMTP_URL=
MAIL_FROM=SureFix <no-reply@surefix.local>
