PORT=4000
# Database name stays "fixit" so data from earlier versions keeps working.
MONGO_URI=mongodb://localhost:27017/fixit
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
AI_SERVICE_URL=http://localhost:5001
# How long the backend waits for the AI service before using its built-in fallback.
AI_TIMEOUT_MS=2500
UPLOAD_DIR=uploads
# Comma-separated browser origins allowed to call the API; * allows all.
CORS_ORIGINS=*
# Requests per 15 minutes per IP (whole API / login+register).
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=30
